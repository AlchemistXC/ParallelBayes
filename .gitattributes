# Preserve canonical UTF-8/LF source bytes across macOS and Windows.
* text=auto eol=lf
*.ps1 text eol=lf
*.R text eol=lf
*.py text eol=lf
*.json text eol=lf
*.stan text eol=lf
*.pdf binary
*.png binary
*.npz binary
*.tar binary
*.gz binary

# Preserve the exact bytes of small diagnostic fixtures.
*.bin binary

# Archived scientific output is byte evidence, including native newline conventions.
benchmark/analysis/outputs/** -text
# Native command receipts retain original bytes; numerical source/tests stay LF.
execution/windows-native/formal-adapter-validation-v1/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
