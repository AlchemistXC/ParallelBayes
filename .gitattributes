# Preserve canonical UTF-8/LF source bytes across macOS and Windows.
* text=auto eol=lf
*.ps1 text eol=lf
*.R text eol=lf
*.py text eol=lf
*.json text eol=lf
*.stan text eol=lf
*.pdf binary
*.png binary
*.npz binary
*.tar binary
*.gz binary

# Preserve the exact bytes of small diagnostic fixtures.
*.bin binary

# Archived scientific output is byte evidence, including native newline conventions.
benchmark/analysis/outputs/** -text
# Native command receipts retain original bytes; numerical source/tests stay LF.
execution/windows-native/formal-adapter-validation-v1/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Generated SVG path formatting is kept from the original renderer; source stays LF.
execution/windows-compact/formal-results/*/*.svg text eol=lf whitespace=-blank-at-eol

# Figure source data retain renderer bytes bound by their SHA256 manifests.
figures/compact-mixture-companion-v1/source.csv -text

benchmark/analysis/outputs/compact-final-reconstruction-v1/*.csv -text whitespace=-blank-at-eol
figures/compact-final-v1/*.svg text eol=lf whitespace=-blank-at-eol

# S2 native receipts/CSV are byte evidence; execution source and tests retain LF.
execution/targeted-followups-v1/nuts-windows-v1/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Preserve H1 derivative CSV bytes, including the CSV writer CRLF terminator.
benchmark/analysis/outputs/h1-function-path-companion-v1/*.csv -text whitespace=-blank-at-eol
benchmark/analysis/outputs/h1-function-path-companion-v1/*.svg -text whitespace=-blank-at-eol
